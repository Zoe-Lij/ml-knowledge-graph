#!/bin/zsh
# ---------------------------------------------------------------------------
# 双击启动器（macOS）：在 Finder 里双击本文件即可启动系统
# 原理：切换到本文件所在目录，然后执行 start.sh（与终端执行 ./start.sh 等价）
# 首次运行会自动创建虚拟环境并安装依赖，请耐心等待约 1 分钟。
# 启动成功后浏览器访问：http://127.0.0.1:8000/
# 关闭弹出的终端窗口（或在窗口里按 Ctrl+C）即停止服务。
# ---------------------------------------------------------------------------
cd "$(dirname "$0")" || exit 1
exec ./start.sh
