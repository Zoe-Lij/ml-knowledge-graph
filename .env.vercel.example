# =============================================================================
# .env.vercel.example —— 云端部署凭据模板
#
# 用法：复制成 .env.vercel（同目录），把值填上即可；两个脚本会自动读取：
#     cp .env.vercel.example .env.vercel
#     python scripts/import_aura.py --reset        # 灌数据到云端
#     python scripts/deploy_vercel.py              # 部署到 Vercel + 自检
#
# 注意：.env.vercel 里是真实密码，不要提交到仓库、不要发群里。
#       本文件（.example）只放占位符，可以提交。
# =============================================================================

# ---------- Vercel ----------
# https://vercel.com/account/tokens → Create Token（Scope 选个人账号）
VERCEL_TOKEN=

# ---------- Neo4j Aura（云端图库）----------
# https://console.neo4j.io → Create instance → AuraDB Free
# 创建后控制台会给出形如 neo4j+s://xxxxxxxx.databases.neo4j.io 的连接地址
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# 线上数据源模式：auto = 优先连图库，连不上才降级到本地 kg.json 兜底
KG_MODE=auto
