// =============================================================================
// 04_demo_queries.cypher —— 演示用查询（覆盖 5 种关系 + 路径 + 统计）
// -----------------------------------------------------------------------------
// 用途：
//   1. 阶段2 导入后自测"图能不能查到东西"；
//   2. 阶段3 后端写接口时当参考实现；
//   3. 阶段7 答辩现场演示（每条对应一句"能回答什么问题"）。
// 执行：逐条粘贴到 Neo4j Browser 运行即可。
// =============================================================================


// -----------------------------------------------------------------------------
// Q1【属于】随机森林属于哪一类？（算法 → 范式）
// 讲稿："随机森林不是孤立存在的，它挂在集成学习这个范式下。"
// -----------------------------------------------------------------------------
MATCH (n:Entity {name: '随机森林'})-[r:`属于`]->(m)
RETURN n.name AS 实体, type(r) AS 关系, m.name AS 归属;


// -----------------------------------------------------------------------------
// Q2【属于·反向】集成学习下面有哪些算法？（范式 → 算法）
// 讲稿："反过来问'某类范式包含哪些算法'也是同一类查询。"
// -----------------------------------------------------------------------------
MATCH (m:Entity {name: '集成学习'})<-[:`属于`]-(n)
RETURN n.name AS 算法, n.type AS 类型
ORDER BY 算法;


// -----------------------------------------------------------------------------
// Q3【基于】支持向量机为什么有效？（方法 → 原理）
// 讲稿："SVM 的两块理论基石：最大间隔 + 核技巧。"
// -----------------------------------------------------------------------------
MATCH (n:Entity {name: '支持向量机'})-[r:`基于`]->(m)
RETURN n.name AS 方法, m.name AS 依赖的原理;


// -----------------------------------------------------------------------------
// Q4【衍生自】XGBoost 从哪来的？（新 → 旧，含多跳谱系）
// 讲稿："既能查直接父类，也能查完整演化链。"
// -----------------------------------------------------------------------------
MATCH p = (n:Entity {name: 'XGBoost'})-[:`衍生自`*1..3]->(m)
RETURN p;


// -----------------------------------------------------------------------------
// Q5【可对比】随机森林和梯度提升树有什么区别？（同类横向对比）
// 讲稿："可对比是双向的，所以查询时不带箭头。"
// -----------------------------------------------------------------------------
MATCH (a:Entity {name: '随机森林'})-[:`可对比`]-(b:Entity)
RETURN b.name AS 可对比对象, b.description AS 一句话区别;


// -----------------------------------------------------------------------------
// Q6【应用于】哪些算法能做异常检测？（任务 → 候选方法，反向查）
// 讲稿："这是选型类问题，图谱能直接给出候选集合。"
// -----------------------------------------------------------------------------
MATCH (n:Entity)-[:`应用于`]->(t:Entity {name: '异常检测任务'})
RETURN n.name AS 候选方法, n.type AS 类型;


// -----------------------------------------------------------------------------
// Q7【组合条件】分类任务可以用哪些指标评估？
// 讲稿："指标是按任务挂的，所以能按任务反查指标。"
// -----------------------------------------------------------------------------
MATCH (m:Metric)-[:`属于`]->(t:Entity {name: '分类任务'})
RETURN m.name AS 指标, m.description AS 说明;


// -----------------------------------------------------------------------------
// Q8【多跳路径】GPT-2 和 Word2Vec 在图里怎么连起来？（最短路径，答辩亮点）
// 讲稿："一个是最早的词向量模型，一个是大规模生成模型，看起来毫无关系，
//        图里 3 跳就通了：GPT-2 → Transformer → 分类任务 ← Word2Vec。
//        不用最短路径也能讲语义：二者都服务于表示学习。"
// 全图统计：平均最短路径 3.5 跳，说明知识点之间不是散落的孤岛。
// -----------------------------------------------------------------------------
MATCH (a:Entity {name: 'GPT-2文本生成模型'}), (b:Entity {name: 'Word2Vec词向量模型'})
MATCH p = shortestPath((a)-[*..8]-(b))
RETURN p, length(p) AS 跳数;


// -----------------------------------------------------------------------------
// Q9【统计】各类型节点数与平均度数（写报告用）
// -----------------------------------------------------------------------------
MATCH (n:Entity)--()
WITH n, count(*) AS deg
RETURN n.type AS 类型,
       count(*) AS 节点数,
       round(avg(deg) * 100) / 100 AS 平均度
ORDER BY 节点数 DESC;


// -----------------------------------------------------------------------------
// Q10【中枢】度数最高的 8 个节点（前端首页默认展示这几个）
// -----------------------------------------------------------------------------
MATCH (n:Entity)--()
WITH n, count(*) AS deg
RETURN n.name AS 实体, n.type AS 类型, deg AS 度数
ORDER BY deg DESC
LIMIT 8;
