// =============================================================================
// 03_verify.cypher —— 导入结果校验（答辩前跑一遍，确认数据完整）
// -----------------------------------------------------------------------------
// 每段都写了"期望值"，实际结果与期望一致才说明导入成功。
// 执行：粘贴到 Neo4j Browser，或 cypher-shell -f cypher/03_verify.cypher
// =============================================================================

// -----------------------------------------------------------------------------
// 1. 总量校验：期望 113 / 257
// -----------------------------------------------------------------------------
MATCH (n:Entity)
RETURN count(n) AS `实体总数_期望113`;

MATCH ()-[r]->()
RETURN count(r) AS `关系总数_期望257`;

// -----------------------------------------------------------------------------
// 2. 实体类型分布：期望 概念38 / 算法34 / 模型23 / 指标18
// -----------------------------------------------------------------------------
MATCH (n:Entity)
RETURN n.type AS `类型`, count(*) AS `数量`
ORDER BY `数量` DESC;

// -----------------------------------------------------------------------------
// 3. 关系类型分布：期望 属于93 / 衍生自22 / 基于29 / 可对比47 / 应用于66
// -----------------------------------------------------------------------------
MATCH ()-[r]->()
RETURN type(r) AS `关系类型`, count(*) AS `数量`
ORDER BY `数量` DESC;

// -----------------------------------------------------------------------------
// 4. 数据质量：孤立节点（期望返回空，说明每个实体都至少有一条边）
// -----------------------------------------------------------------------------
MATCH (n:Entity)
WHERE NOT (n)--()
RETURN n.name AS `孤立节点`;

// -----------------------------------------------------------------------------
// 5. 数据质量：重名节点（期望返回空，唯一约束应保证不重复）
// -----------------------------------------------------------------------------
MATCH (n:Entity)
WITH n.name AS name, count(*) AS c
WHERE c > 1
RETURN name, c;

// -----------------------------------------------------------------------------
// 6. 标签完整性：4 类标签各自的节点数（防止某类标签漏建）
// -----------------------------------------------------------------------------
MATCH (n:Concept)   RETURN 'Concept'   AS `标签`, count(n) AS `数量`
UNION ALL
MATCH (n:Algorithm) RETURN 'Algorithm' AS `标签`, count(n) AS `数量`
UNION ALL
MATCH (n:Model)     RETURN 'Model'     AS `标签`, count(n) AS `数量`
UNION ALL
MATCH (n:Metric)    RETURN 'Metric'    AS `标签`, count(n) AS `数量`;

// -----------------------------------------------------------------------------
// 7. 抽样人工核对：随机森林的全部一跳邻居（应能看到 决策树/Bagging/集成学习/分类任务...）
// -----------------------------------------------------------------------------
MATCH (n:Entity {name: '随机森林'})-[r]-(m:Entity)
RETURN type(r) AS `关系`, m.name AS `邻居`, m.type AS `类型`
ORDER BY `关系`, `邻居`;

// -----------------------------------------------------------------------------
// 8. 度数 Top5（枢纽节点，前端默认展示它们效果最好）
// -----------------------------------------------------------------------------
MATCH (n:Entity)--()
WITH n, count(*) AS deg
RETURN n.name AS `实体`, n.type AS `类型`, deg AS `度数`
ORDER BY `度数` DESC
LIMIT 5;

// -----------------------------------------------------------------------------
// 9. 关系方向抽检：属于 应指向"更上位"的概念（算法 → 范式，任务 → 范式）
// -----------------------------------------------------------------------------
MATCH (a:Algorithm)-[:`属于`]->(b:Concept)
RETURN a.name AS `算法`, b.name AS `所属范式`
LIMIT 10;

// -----------------------------------------------------------------------------
// 10. 置信度分布（期望 0.98:33 / 0.92:27 / 0.86:120 / 0.78:77）
//     如果这里返回 null，说明入库时没写 confidence 属性 ——
//     用 scripts/import_neo4j.py 重导，或确认 LOAD CSV 用的是 relations.csv。
// -----------------------------------------------------------------------------
MATCH ()-[r]->()
RETURN r.confidence AS `置信度`, head(collect(r.evidence)) AS `依据`, count(*) AS `条数`
ORDER BY `置信度` DESC;

// 10.1 待复核清单（< 0.80，与 data/low_confidence_relations.csv 对应）
MATCH (a)-[r]->(b)
WHERE coalesce(r.confidence, 1.0) < 0.80
RETURN a.name AS `头实体`, type(r) AS `关系`, b.name AS `尾实体`, r.confidence AS `置信度`
ORDER BY `置信度`, `头实体`
LIMIT 25;
