# =============================================================================
# .env.example —— 环境配置模板（导入脚本 与 后端服务 共用同一份）
#
# 使用方法：
#   cp .env.example .env
#   把 NEO4J_PASSWORD 换成你创建数据库时设置的真实密码
#
# 说明：
#   .env 含密码，不要提交到 git（.gitignore 已排除）；
#   不建 .env 也能跑，代码里有相同的默认值（见 app/config.py）
# =============================================================================

# ---------- Neo4j 连接 ----------
# Bolt 协议地址（注意是 7687，不是浏览器界面的 7474）
NEO4J_URI=bolt://localhost:7687

# Neo4j 用户名，桌面版默认就是 neo4j
NEO4J_USER=neo4j

# 创建 DBMS 时设置的密码；不要把真实密码提交到仓库，本文件只保留占位符
NEO4J_PASSWORD=你的Neo4j密码

# ---------- 后端服务 ----------
# local = 只用本地 data/kg.json（不需要数据库，答辩兜底）
# neo4j = 只查数据库（数据库没起来会直接报 503，用于证明"确实在查图库"）
# auto  = 优先数据库，连不上自动降级 local（默认）
KG_MODE=auto

API_HOST=127.0.0.1
API_PORT=8000
